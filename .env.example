# Resend — envío del formulario de contacto (/acerca)
# Crea la API key en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Destino de los mensajes. En sandbox (onboarding@resend.dev) Resend SOLO
# entrega al correo dueño de la cuenta de Resend.
CONTACT_TO_EMAIL=tu-correo@ejemplo.com

# Opcional. Por defecto: Arcade Vault <onboarding@resend.dev>
# Cambia a un dominio verificado cuando lo tengas.
CONTACT_FROM_EMAIL="Arcade Vault <onboarding@resend.dev>"
